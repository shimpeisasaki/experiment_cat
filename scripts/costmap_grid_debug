#!/usr/bin/env python3
"""Expose a Nav2 Costmap as an RViz-compatible OccupancyGrid for diagnosis."""

import rclpy
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from nav2_msgs.msg import Costmap
from nav_msgs.msg import OccupancyGrid


class CostmapGridDebug(Node):
    def __init__(self):
        super().__init__('costmap_grid_debug')
        input_topic = self.declare_parameter(
            'input_topic', '/local_costmap/costmap_raw').value
        output_topic = self.declare_parameter(
            'output_topic', '/debug/local_costmap_raw').value

        input_qos = QoSProfile(depth=1, reliability=ReliabilityPolicy.BEST_EFFORT)
        output_qos = QoSProfile(
            depth=1, reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.TRANSIENT_LOCAL)
        self.publisher = self.create_publisher(OccupancyGrid, output_topic, output_qos)
        self.subscription = self.create_subscription(
            Costmap, input_topic, self.receive, input_qos)
        self.get_logger().info(f'Visualizing {input_topic} as {output_topic}')

    def receive(self, costmap):
        grid = OccupancyGrid()
        grid.header = costmap.header
        grid.info.map_load_time = costmap.metadata.map_load_time
        grid.info.resolution = costmap.metadata.resolution
        grid.info.width = costmap.metadata.size_x
        grid.info.height = costmap.metadata.size_y
        grid.info.origin = costmap.metadata.origin
        # Nav2 costs: 255 unknown; 254 lethal; 253 inscribed; 0--252 gradient.
        grid.data = [
            -1 if value == 255 else 100 if value >= 253 else
            round(value * 99 / 252)
            for value in costmap.data
        ]
        self.publisher.publish(grid)


def main():
    rclpy.init()
    node = CostmapGridDebug()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
