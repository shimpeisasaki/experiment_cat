#!/usr/bin/env python3
"""Compare one-view and three-view ground classification from a ZED image topic."""

import base64
import json
import threading
import time
from urllib.request import Request, urlopen

import cv2
import numpy as np
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import Image
from std_msgs.msg import String
from std_srvs.srv import SetBool, Trigger


CLASSES = {
    'indoor_floor': 'Indoor floor such as a corridor, lobby, tile, or carpet.',
    'pedestrian_pavement': 'Outdoor pavement intended for pedestrians, such as a sidewalk or paved path.',
    'grass_soil': 'Grass, planted area, bare soil, or other unpaved ground.',
    'road': 'Vehicle roadway or parking/driving surface.',
    'other_unknown': 'Different surface, mixed surfaces, or insufficient visual evidence.',
}


def crops(image, mode):
    height, width = image.shape[:2]
    if height < 2 or width < 4:
        raise ValueError('Image too small')
    bottom = image[height // 2:, :]
    if mode == 'one':
        return {'whole': bottom}
    half = width // 2
    quarter = width // 4
    return {'left': bottom[:, :half],
            'center': bottom[:, quarter:quarter + half],
            'right': bottom[:, width - half:]}


def image_to_bgr(msg):
    channels = {'bgr8': 3, 'rgb8': 3, 'bgra8': 4, 'rgba8': 4}
    count = channels.get(msg.encoding.lower())
    if count is None or msg.is_bigendian or msg.step < msg.width * count:
        raise ValueError(f'Unsupported image encoding/step: {msg.encoding}/{msg.step}')
    raw = np.frombuffer(msg.data, dtype=np.uint8)
    if raw.size < msg.height * msg.step:
        raise ValueError('Incomplete image buffer')
    pixels = raw[:msg.height * msg.step].reshape(msg.height, msg.step)
    pixels = pixels[:, :msg.width * count].reshape(msg.height, msg.width, count)
    conversions = {'rgb8': cv2.COLOR_RGB2BGR, 'bgra8': cv2.COLOR_BGRA2BGR,
                   'rgba8': cv2.COLOR_RGBA2BGR}
    return cv2.cvtColor(pixels, conversions[msg.encoding.lower()]) if count != 3 or msg.encoding.lower() == 'rgb8' else pixels


def encode_jpeg(image, max_edge, quality):
    height, width = image.shape[:2]
    scale = min(1.0, max_edge / max(width, height))
    if scale < 1.0:
        image = cv2.resize(image, (max(1, round(width * scale)), max(1, round(height * scale))),
                           interpolation=cv2.INTER_AREA)
    ok, encoded = cv2.imencode('.jpg', image, [cv2.IMWRITE_JPEG_QUALITY, quality])
    if not ok:
        raise ValueError('JPEG encoding failed')
    return 'data:image/jpeg;base64,' + base64.b64encode(encoded).decode('ascii')


def question(region):
    return {'type': 'choice',
            'instructions': (f'Classify the ground surface in the {region} region closest to the '
                             'robot. Use only visible evidence. If the region crosses a boundary, '
                             'is obstructed, or cannot be identified, choose other_unknown. '
                             'Do not infer that a surface is safe to drive on.'),
            'criteria': CLASSES}


def make_requests(images, mode):
    state = ('Forward-facing robot camera, indoors or outdoors. Evaluate visible ground only. '
             'These labels are observations, not permission to drive. Image left is robot left.')
    if mode == 'one':
        return [{'state': state + (' Evaluate three overlapping regions of this one image: '
                                   'left is x=0-50%, center is x=25-75%, right is x=50-100%. '
                                   'Each region covers the full image height.'),
                 'images': [images['whole']],
                 'questions': {name: question(name) for name in ('left', 'center', 'right')}}]
    return [{'state': state + f' This image is the {name} view of the lower camera image.',
             'images': [images[name]], 'questions': {'ground': question(name)}}
            for name in ('left', 'center', 'right')]


def infer(server, payload, timeout):
    request = Request(server.rstrip('/') + '/v1/systemone',
                      data=json.dumps(payload, separators=(',', ':')).encode('utf-8'),
                      headers={'Content-Type': 'application/json'}, method='POST')
    with urlopen(request, timeout=timeout) as response:
        result = json.load(response)
    if not isinstance(result, dict) or not isinstance(result.get('answers'), dict):
        raise ValueError('Invalid System One response')
    return result['answers']


class D1GroundEval(Node):
    def __init__(self):
        super().__init__('d1_ground_eval')
        self.image_topic = self.declare_parameter('image_topic', '/zed/zed_node/rgb/color/rect/image').value
        self.server = self.declare_parameter('server', 'http://127.0.0.1:8080').value
        self.max_edge_three = int(self.declare_parameter('max_edge_three', 384).value)
        self.max_edge_one = int(self.declare_parameter('max_edge_one', 768).value)
        self.jpeg_quality = int(self.declare_parameter('jpeg_quality', 80).value)
        self.timeout = float(self.declare_parameter('timeout', 30.0).value)
        self.max_image_age = float(self.declare_parameter('max_image_age', 2.0).value)
        if (min(self.max_edge_one, self.max_edge_three) < 32 or
                not 1 <= self.jpeg_quality <= 100 or self.timeout <= 0 or self.max_image_age <= 0):
            raise ValueError('Invalid image or timeout parameters')
        self.lock = threading.Lock()
        self.latest = None
        self.active = False
        self.mode = 'one'
        self.generation = 0
        self.busy = False
        self.last_stamp = None
        self.results = self.create_publisher(String, '~/result', 10)
        self.create_subscription(Image, self.image_topic, self.on_image, qos_profile_sensor_data)
        self.create_service(SetBool, '~/start', self.start)
        self.create_service(Trigger, '~/stop', self.stop)
        self.create_timer(0.05, self.tick)

    def on_image(self, msg):
        with self.lock:
            self.latest = msg

    def start(self, request, response):
        with self.lock:
            self.mode = 'three' if request.data else 'one'
            self.active = True
            self.generation += 1
            self.last_stamp = None
        response.success = True
        response.message = f'Ground evaluation started: {self.mode}'
        return response

    def stop(self, request, response):
        with self.lock:
            self.active = False
            self.generation += 1
        response.success = True
        response.message = 'Ground evaluation stopped; in-flight result will be discarded'
        return response

    def tick(self):
        with self.lock:
            if not self.active or self.busy or self.latest is None:
                return
            image = self.latest
            stamp_ns = image.header.stamp.sec * 1_000_000_000 + image.header.stamp.nanosec
            if stamp_ns == self.last_stamp:
                return
            now_ns = self.get_clock().now().nanoseconds
            age = (now_ns - stamp_ns) / 1e9
            if stamp_ns <= 0 or age < -0.2 or age > self.max_image_age:
                return
            self.last_stamp = stamp_ns
            self.busy = True
            mode, generation = self.mode, self.generation
        threading.Thread(target=self.process, args=(image, stamp_ns, mode, generation), daemon=True).start()

    def process(self, image, stamp_ns, mode, generation):
        started = time.perf_counter()
        output = {'mode': mode, 'image_stamp_ns': stamp_ns, 'frame_id': image.header.frame_id}
        try:
            views = crops(image_to_bgr(image), mode)
            max_edge = self.max_edge_one if mode == 'one' else self.max_edge_three
            encoded = {name: encode_jpeg(view, max_edge, self.jpeg_quality)
                       for name, view in views.items()}
            requests = make_requests(encoded, mode)
            output['preprocess_ms'] = round((time.perf_counter() - started) * 1000, 1)
            answers = {}
            inference_started = time.perf_counter()
            for name, payload in zip((['whole'] if mode == 'one' else ['left', 'center', 'right']), requests):
                with self.lock:
                    if generation != self.generation:
                        return
                result = infer(self.server, payload, self.timeout)
                if mode == 'one':
                    answers = {key: result[key] for key in ('left', 'center', 'right')}
                else:
                    answers[name] = result['ground']
            output['inference_ms'] = round((time.perf_counter() - inference_started) * 1000, 1)
            output['answers'] = answers
            output['status'] = 'ok'
        except Exception as exc:
            output['status'] = 'error'
            output['error'] = str(exc)
            self.get_logger().error(f'D1 ground evaluation failed: {exc}')
        finally:
            output['total_ms'] = round((time.perf_counter() - started) * 1000, 1)
            output['result_stamp_ns'] = self.get_clock().now().nanoseconds
            output['image_age_at_result_ms'] = round((output['result_stamp_ns'] - stamp_ns) / 1e6, 1)
            with self.lock:
                if generation == self.generation and self.active:
                    self.results.publish(String(data=json.dumps(output, ensure_ascii=False)))
                self.busy = False


def main():
    rclpy.init()
    node = D1GroundEval()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
